rules_version = '2';

// 실제 환자 개인정보를 다루지 않는 내부 훈련 도구이므로(PRD Out-of-Scope: 실제 환자 정보 입력 기능),
// 익명 인증된 사용자에게 세션 문서에 대한 read/write를 허용하는 단순 규칙을 사용한다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /sessions/{sessionId} {
      allow read, write: if request.auth != null;

      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
